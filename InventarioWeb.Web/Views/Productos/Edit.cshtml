@model InventarioWeb.Core.DTOs.ProductoDto
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card animate-in">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar Producto</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Codigo" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc"></i></span>
                                <input asp-for="Codigo" class="form-control" />
                            </div>
                            <span asp-validation-for="Codigo" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnidadMedidaId" class="form-label">Unidad de Medida <span class="text-danger">*</span></label>
                            <select asp-for="UnidadMedidaId" class="form-select" asp-items="ViewBag.UnidadesMedida" id="unidadMedidaSelect" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="UnidadMedidaId" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5><i class="bi bi-currency-dollar"></i> Precios</h5>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="PrecioCosto" class="form-label">Precio de Costo <small class="text-muted">(opcional)</small></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioCosto" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PrecioCosto" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrecioVentaMinorista" class="form-label">Precio Minorista <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioVentaMinorista" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PrecioVentaMinorista" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrecioVentaMayorista" class="form-label">Precio Mayorista <small class="text-muted">(opcional)</small></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioVentaMayorista" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PrecioVentaMayorista" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5><i class="bi bi-arrow-left-right"></i> Conversor de Unidades</h5>

                    <div class="row mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Unidad Origen</label>
                            <select id="convUnidadOrigen" class="form-select" asp-items="ViewBag.UnidadesMedida">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Cantidad</label>
                            <input id="convCantidad" class="form-control" type="number" step="0.01" value="1" min="0.01" />
                        </div>
                        <div class="col-md-1 text-center">
                            <i class="bi bi-arrow-right fs-3 text-muted"></i>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Unidad Destino</label>
                            <select id="convUnidadDestino" class="form-select" asp-items="ViewBag.UnidadesMedida">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Resultado</label>
                            <input id="convResultado" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-1">
                            <button type="button" id="btnConvertir" class="btn btn-info w-100" title="Convertir">
                                <i class="bi bi-calculator"></i>
                            </button>
                        </div>
                    </div>
                    <div id="convMensaje" class="alert alert-info small" style="display:none;"></div>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Actualizar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Autollenar unidad origen con la seleccionada
            $('#unidadMedidaSelect').change(function() {
                $('#convUnidadOrigen').val($(this).val());
            });

            if ($('#unidadMedidaSelect').val()) {
                $('#convUnidadOrigen').val($('#unidadMedidaSelect').val());
            }

            function realizarConversion() {
                var origenId = $('#convUnidadOrigen').val();
                var destinoId = $('#convUnidadDestino').val();
                var cantidad = parseFloat($('#convCantidad').val());

                if (!origenId || !destinoId) return;
                if (!cantidad || cantidad <= 0) {
                    $('#convMensaje').show().removeClass('alert-info alert-success').addClass('alert-warning')
                        .html('<i class="bi bi-exclamation-triangle"></i> Ingrese una cantidad válida');
                    return;
                }

                $.get('/Productos/ConvertirUnidad', {
                    unidadOrigenId: origenId,
                    unidadDestinoId: destinoId,
                    cantidad: cantidad
                }, function(data) {
                    if (data.success) {
                        $('#convResultado').val(data.resultado);
                        $('#convMensaje').show().removeClass('alert-warning alert-info').addClass('alert-success')
                            .html('<i class="bi bi-check-circle"></i> ' + cantidad + ' × ' + data.factor + ' = <strong>' + data.resultado + '</strong>');
                    } else {
                        $('#convResultado').val('');
                        $('#convMensaje').show().removeClass('alert-success alert-info').addClass('alert-warning')
                            .html('<i class="bi bi-exclamation-triangle"></i> ' + data.mensaje);
                    }
                });
            }

            $('#btnConvertir').click(realizarConversion);

            $('#convUnidadDestino').change(function() {
                if ($('#convUnidadOrigen').val() && $(this).val()) realizarConversion();
            });

            $('#convCantidad').on('input', function() {
                if ($('#convUnidadOrigen').val() && $('#convUnidadDestino').val() && $(this).val()) realizarConversion();
            });
        });
    </script>
}
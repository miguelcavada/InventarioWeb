@model IEnumerable<InventarioWeb.Core.DTOs.HistorialPrecioDto>
@{
    ViewData["Title"] = "Historial de Cambios de Precios";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clock-history"></i> Historial de Cambios de Precios</h2>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPIs -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #4361ee, #3a0ca3);">
            <div class="icon"><i class="bi bi-clock-history"></i></div>
            <div class="label">Total Cambios</div>
            <div class="value">@ViewBag.TotalCambios</div>
            <small>registrados</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #2ec4b6, #20a39e);">
            <div class="icon"><i class="bi bi-calendar-day"></i></div>
            <div class="label">Cambios Hoy</div>
            <div class="value">@ViewBag.CambiosHoy</div>
            <small>en el día</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #e71d36, #c9184a);">
            <div class="icon"><i class="bi bi-arrow-up"></i></div>
            <div class="label">Aumentos</div>
            <div class="value">@ViewBag.Aumentos</div>
            <small>precios subieron</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #ff9f1c, #ff6d00);">
            <div class="icon"><i class="bi bi-arrow-down"></i></div>
            <div class="label">Disminuciones</div>
            <div class="value">@ViewBag.Disminuciones</div>
            <small>precios bajaron</small>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-3">
                <label class="form-label small">Buscar producto</label>
                <input type="text" name="buscar" class="form-control"
                       placeholder="Nombre o código..."
                       value="@ViewBag.Buscar" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Desde</label>
                <input type="date" name="desde" class="form-control"
                       value="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Hasta</label>
                <input type="date" name="hasta" class="form-control"
                       value="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Usuario</label>
                <input type="text" name="usuario" class="form-control"
                       placeholder="Email usuario..."
                       value="@ViewBag.Usuario" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="text-muted">Sin cambios de precios registrados</h4>
                <p>No hay cambios que coincidan con los filtros aplicados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Producto</th>
                            <th class="text-end">Costo Anterior</th>
                            <th class="text-end">Costo Nuevo</th>
                            <th class="text-end">Venta Anterior</th>
                            <th class="text-end">Venta Nuevo</th>
                            <th class="text-center">Variación</th>
                            <th>Motivo</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var variacion = item.PorcentajeVariacion;
                            var badgeClass = variacion > 0 ? "bg-danger" : variacion < 0 ? "bg-success" : "bg-secondary";
                            var icono = variacion > 0 ? "↑" : variacion < 0 ? "↓" : "=";
                            var textoVariacion = variacion > 0 ? "Aumentó" : variacion < 0 ? "Bajó" : "Igual";

                            <tr>
                                <td>
                                    <small>
                                        <i class="bi bi-calendar"></i> @item.FechaCambio.ToString("dd/MM/yyyy")<br>
                                        <i class="bi bi-clock"></i> @item.FechaCambio.ToString("HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <a asp-controller="Productos" asp-action="Details" asp-route-id="@item.ProductoId"
                                       class="text-decoration-none">
                                        <strong>@item.ProductoNombre</strong>
                                    </a>
                                    <br><code class="small">@item.ProductoCodigo</code>
                                </td>
                                <td class="text-end">
                                    @if (item.PrecioCostoAnterior.HasValue)
                                    {
                                        @item.PrecioCostoAnterior.Value.ToString("C2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.PrecioCostoNuevo.HasValue)
                                    {
                                        @item.PrecioCostoNuevo.Value.ToString("C2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">@item.PrecioVentaAnterior.ToString("C2")</td>
                                <td class="text-end"><strong>@item.PrecioVentaNuevo.ToString("C2")</strong></td>
                                <td class="text-center">
                                    <span class="badge @badgeClass" title="@textoVariacion">
                                        @icono @Math.Abs(variacion).ToString("F1")%
                                    </span>
                                </td>
                                <td>
                                    <small>@(string.IsNullOrEmpty(item.Motivo) ? "Sin motivo" : item.Motivo)</small>
                                </td>
                                <td>
                                    <small>
                                        <i class="bi bi-person-circle"></i> @item.UsuarioCambio
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (totalPaginas > 1)
            {
                <nav aria-label="Paginación del historial">
                    <ul class="pagination justify-content-center mt-3">
                        <!-- Anterior -->
                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual - 1)"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-desde="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))"
                               asp-route-hasta="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))"
                               asp-route-usuario="@ViewBag.Usuario">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </a>
                        </li>

                        @{
                            int inicio = Math.Max(1, paginaActual - 2);
                            int fin = Math.Min(totalPaginas, paginaActual + 2);
                        }

                        @if (inicio > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="1"
                                   asp-route-buscar="@ViewBag.Buscar"
                                   asp-route-desde="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))"
                                   asp-route-hasta="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))"
                                   asp-route-usuario="@ViewBag.Usuario">1</a>
                            </li>
                            @if (inicio > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = inicio; i <= fin; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-buscar="@ViewBag.Buscar"
                                   asp-route-desde="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))"
                                   asp-route-hasta="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))"
                                   asp-route-usuario="@ViewBag.Usuario">@i</a>
                            </li>
                        }

                        @if (fin < totalPaginas)
                        {
                            @if (fin < totalPaginas - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@totalPaginas"
                                   asp-route-buscar="@ViewBag.Buscar"
                                   asp-route-desde="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))"
                                   asp-route-hasta="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))"
                                   asp-route-usuario="@ViewBag.Usuario">@totalPaginas</a>
                            </li>
                        }

                        <!-- Siguiente -->
                        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual + 1)"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-desde="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))"
                               asp-route-hasta="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))"
                               asp-route-usuario="@ViewBag.Usuario">
                                Siguiente <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="text-center text-muted">
                    <small>
                        Mostrando @((paginaActual - 1) * 20 + 1) -
                        @(Math.Min(paginaActual * 20, totalRegistros))
                        de @totalRegistros cambio(s) de precio(s)
                    </small>
                </div>
            }
            else
            {
                <div class="text-center text-muted mt-3">
                    <small>Mostrando @totalRegistros cambio(s) de precio(s)</small>
                </div>
            }
        }
    </div>
</div>
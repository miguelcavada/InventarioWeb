@model InventarioWeb.Core.DTOs.MovimientoDto
@{
    var esEntrada = Model.Tipo == "ENTRADA";
    var esSalida = Model.Tipo == "SALIDA";
    var esTraslado = Model.Tipo == "TRASLADO";

    ViewData["Title"] = esEntrada ? "Nueva Entrada" : esSalida ? "Nueva Salida" : "Nuevo Traslado";
}

<div class="row">
    <div class="col-md-11 mx-auto">
        <div class="card">
            <div class="card-header @(esEntrada ? "bg-success" : esSalida ? "bg-danger" : "bg-info") text-white">
                <h4 class="mb-0">
                    <i class="bi @(esEntrada ? "bi-box-arrow-in-down" : esSalida ? "bi-box-arrow-up" : "bi-arrow-left-right")"></i>
                    @ViewData["Title"]
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" id="formMovimiento">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Tipo" id="tipoMovimiento" />

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="NumeroDocumento" class="form-label"></label>
                            <input asp-for="NumeroDocumento" class="form-control" placeholder="DOC-001" required />
                            <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FechaMovimiento" class="form-label"></label>
                            <input asp-for="FechaMovimiento" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaMovimiento" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Observacion" class="form-label"></label>
                            <input asp-for="Observacion" class="form-control" placeholder="Observaciones..." />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="AlmacenOrigenId" class="form-label">
                                @(esTraslado ? "Almacén Origen" : "Almacén") <span class="text-danger">*</span>
                            </label>
                            <select asp-for="AlmacenOrigenId" class="form-select" asp-items="ViewBag.Almacenes" required id="cmbAlmacenOrigen">
                                <option value="">-- Seleccione un almacén --</option>
                            </select>
                        </div>

                        @if (esTraslado)
                        {
                            <div class="col-md-4">
                                <label asp-for="AlmacenDestinoId" class="form-label">
                                    Almacén Destino <span class="text-danger">*</span>
                                </label>
                                <select asp-for="AlmacenDestinoId" class="form-select" asp-items="ViewBag.Almacenes" required>
                                    <option value="">-- Seleccione almacén destino --</option>
                                </select>
                            </div>
                        }

                        @if (esSalida)
                        {
                            <div class="col-md-4">
                                <label asp-for="MotivoSalida" class="form-label">Motivo</label>
                                <select asp-for="MotivoSalida" class="form-select" id="cmbMotivoSalida">
                                    <option value="VENTA">Venta al público</option>
                                    <option value="MERMA">Merma / Producto dañado</option>
                                    <option value="DEVOLUCION">Devolución a proveedor</option>
                                    <option value="AJUSTE">Ajuste de inventario</option>
                                    <option value="OTRO">Otro motivo</option>
                                </select>
                            </div>
                        }
                    </div>

                    <hr />
                    <h5><i class="bi bi-list-check"></i> Detalles del Movimiento</h5>

                    <div id="estadoProductos" class="alert alert-secondary">
                        <i class="bi bi-info-circle"></i>
                        Seleccione un almacén para cargar los productos disponibles.
                    </div>

                    <!-- Área para agregar productos -->
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label small">Producto</label>
                                    <select id="cmbProducto" class="form-select" disabled>
                                        <option value="">-- Seleccione primero un almacén --</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Cantidad</label>
                                    <input id="txtCantidad" class="form-control" type="number" step="0.01" min="0.01" value="1" disabled />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Stock</label>
                                    <input id="txtStockInfo" class="form-control bg-white" readonly disabled />
                                </div>
                                <div class="col-md-3">
                                    <button type="button" id="btnAgregarProducto" class="btn btn-success w-100" disabled>
                                        <i class="bi bi-plus-circle"></i> Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles agregados -->
                    <div id="detallesContainer">
                        <!-- Los detalles se agregan dinámicamente -->
                    </div>

                    <div class="alert alert-info d-none" id="sinDetalles">
                        <i class="bi bi-info-circle"></i> No hay productos agregados al movimiento.
                    </div>

                    <div class="text-end mb-3">
                        <h4>Total: <span id="totalMovimiento" class="text-success">$0.00</span></h4>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn @(esEntrada ? "btn-success" : esSalida ? "btn-danger" : "btn-info")">
                            <i class="bi bi-save"></i> Registrar Movimiento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let detalleIndex = 0;
        const tipoMovimiento = $('#tipoMovimiento').val();
        let productosDelAlmacen = [];

        $(document).ready(function() {
            // Cargar productos cuando cambia el almacén origen
            $('#cmbAlmacenOrigen').change(function() {
                const almacenId = $(this).val();

                if (!almacenId) {
                    resetComboProductos();
                    return;
                }

                cargarProductosPorAlmacen(almacenId);
            });

            // Mostrar stock al seleccionar producto
            $('#cmbProducto').change(function() {
                const productoId = parseInt($(this).val());
                const producto = productosDelAlmacen.find(p => p.id === productoId);

                if (producto) {
                    $('#txtStockInfo').val(`${producto.stock} ${producto.unidad}`);
                } else {
                    $('#txtStockInfo').val('');
                }
            });

            // Agregar producto al detalle
            $('#btnAgregarProducto').click(agregarProductoAlDetalle);

            // Eliminar detalle
            $(document).on('click', '.btn-remove-detalle', function() {
                $(this).closest('.detalle-item').remove();
                actualizarSubtotales();
                toggleSinDetalles();
            });

            // Enter en cantidad para agregar
            $('#txtCantidad').keypress(function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    agregarProductoAlDetalle();
                }
            });
        });

        // ============================================================
        // CARGAR PRODUCTOS POR ALMACÉN
        // ============================================================
        function cargarProductosPorAlmacen(almacenId) {
            $('#estadoProductos')
                .removeClass('alert-secondary alert-success alert-warning alert-danger')
                .addClass('alert-info')
                .html('<i class="bi bi-hourglass-split"></i> Cargando productos...');

            $.ajax({
                url: '@Url.Action("GetProductosPorAlmacen", "Movimientos")',
                type: 'GET',
                data: { almacenId: almacenId },
                success: function(response) {
                    if (!response.success) {
                        $('#estadoProductos')
                            .removeClass('alert-info alert-success')
                            .addClass('alert-warning')
                            .html(`<i class="bi bi-exclamation-triangle"></i> ${response.message}`);
                        resetComboProductos();
                        return;
                    }

                    productosDelAlmacen = response.data;

                    if (productosDelAlmacen.length === 0) {
                        $('#estadoProductos')
                            .removeClass('alert-info alert-success')
                            .addClass('alert-warning')
                            .html('<i class="bi bi-exclamation-triangle"></i> Este almacén no tiene productos con stock.');
                        resetComboProductos();
                        return;
                    }

                    // Llenar combo
                    let options = '<option value="">-- Seleccione un producto --</option>';
                    productosDelAlmacen.forEach(p => {
                        options += `<option value="${p.id}">${p.display}</option>`;
                    });

                    $('#cmbProducto').html(options).prop('disabled', false);
                    $('#txtCantidad').prop('disabled', false);
                    $('#btnAgregarProducto').prop('disabled', false);

                    $('#estadoProductos')
                        .removeClass('alert-info alert-warning')
                        .addClass('alert-success')
                        .html(`<i class="bi bi-check-circle"></i> ${productosDelAlmacen.length} producto(s) con stock disponible.`);
                },
                error: function() {
                    $('#estadoProductos')
                        .removeClass('alert-info alert-success')
                        .addClass('alert-danger')
                        .html('<i class="bi bi-exclamation-triangle"></i> Error al cargar productos.');
                    resetComboProductos();
                }
            });
        }

        function resetComboProductos() {
            $('#cmbProducto').html('<option value="">-- Seleccione primero un almacén --</option>').prop('disabled', true);
            $('#txtCantidad').prop('disabled', true).val(1);
            $('#txtStockInfo').val('');
            $('#btnAgregarProducto').prop('disabled', true);
            productosDelAlmacen = [];
        }

        // ============================================================
        // AGREGAR PRODUCTO AL DETALLE
        // ============================================================
        function agregarProductoAlDetalle() {
            const productoId = parseInt($('#cmbProducto').val());
            const cantidad = parseFloat($('#txtCantidad').val());

            if (!productoId) {
                Swal.fire('Aviso', 'Seleccione un producto', 'warning');
                return;
            }

            if (!cantidad || cantidad <= 0) {
                Swal.fire('Aviso', 'Ingrese una cantidad válida', 'warning');
                return;
            }

            const producto = productosDelAlmacen.find(p => p.id === productoId);
            if (!producto) return;

            // Validar stock para salidas y traslados
            if (tipoMovimiento === 'SALIDA' || tipoMovimiento === 'TRASLADO') {
                const cantidadExistente = calcularCantidadExistente(productoId);
                const cantidadTotal = cantidadExistente + cantidad;

                if (cantidadTotal > producto.stock) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Stock insuficiente',
                        html: `
                            <strong>${producto.nombre}</strong><br><br>
                            Stock disponible: <b>${producto.stock} ${producto.unidad}</b><br>
                            Cantidad solicitada: <b>${cantidadTotal}</b>
                        `
                    });
                    return;
                }
            }

            // Verificar si ya existe el producto en los detalles
            const existente = $(`.detalle-item input[name$=".ProductoId"][value="${productoId}"]`).closest('.detalle-item');

            if (existente.length > 0) {
                // Actualizar cantidad existente
                const cantidadInput = existente.find('.cantidad-input');
                const nuevaCantidad = parseFloat(cantidadInput.val()) + cantidad;
                cantidadInput.val(nuevaCantidad);

                // Actualizar subtotal
                const precio = parseFloat(existente.find('.precio-input').val());
                existente.find('.subtotal-input').val('$' + (nuevaCantidad * precio).toFixed(2));
            } else {
                // Calcular precio automático
                const precio = calcularPrecio(producto);

                const subtotal = cantidad * precio;

                const template = `
                    <div class="detalle-item mb-2 border rounded p-2">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-1 text-center">
                                <i class="bi bi-box-seam text-primary fs-5"></i>
                            </div>
                            <div class="col-md-4">
                                <input type="hidden" name="Detalles[${detalleIndex}].ProductoId" value="${producto.id}" />
                                <strong>${producto.codigo}</strong><br>
                                <small class="text-muted">${producto.nombre}</small>
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted">Cantidad</label>
                                <input name="Detalles[${detalleIndex}].Cantidad" class="form-control form-control-sm cantidad-input"
                                       type="number" step="0.01" value="${cantidad}" readonly />
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted">Precio</label>
                                <input name="Detalles[${detalleIndex}].PrecioUnitario" class="form-control form-control-sm precio-input"
                                       type="number" step="0.01" value="${precio.toFixed(2)}" readonly />
                            </div>
                            <div class="col-md-2">
                                <label class="small text-muted">Subtotal</label>
                                <input class="form-control form-control-sm subtotal-input bg-light" value="$${subtotal.toFixed(2)}" readonly />
                            </div>
                            <div class="col-md-1 text-end">
                                <button type="button" class="btn btn-danger btn-sm btn-remove-detalle">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>`;

                $('#detallesContainer').append(template);
                detalleIndex++;
            }

            // Limpiar campos
            $('#cmbProducto').val('');
            $('#txtCantidad').val(1);
            $('#txtStockInfo').val('');

            actualizarSubtotales();
            toggleSinDetalles();
        }

        function calcularCantidadExistente(productoId) {
            let total = 0;
            $('.detalle-item').each(function() {
                const id = parseInt($(this).find('input[name$=".ProductoId"]').val());
                if (id === productoId) {
                    total += parseFloat($(this).find('.cantidad-input').val()) || 0;
                }
            });
            return total;
        }

        function calcularPrecio(producto) {
            if (tipoMovimiento === 'ENTRADA') {
                return producto.precioCosto || 0;
            } else if (tipoMovimiento === 'SALIDA') {
                const motivo = $('#cmbMotivoSalida').val();
                if (motivo === 'VENTA') {
                    return producto.precioMinorista;
                } else {
                    return producto.precioCosto || producto.precioMinorista;
                }
            } else if (tipoMovimiento === 'TRASLADO') {
                return producto.precioCosto || producto.precioMinorista;
            }
            return 0;
        }

        function actualizarSubtotales() {
            let total = 0;
            $('.detalle-item').each(function() {
                const cantidad = parseFloat($(this).find('.cantidad-input').val()) || 0;
                const precio = parseFloat($(this).find('.precio-input').val()) || 0;
                const subtotal = cantidad * precio;
                $(this).find('.subtotal-input').val('$' + subtotal.toFixed(2));
                total += subtotal;
            });
            $('#totalMovimiento').text('$' + total.toFixed(2));
        }

        function toggleSinDetalles() {
            if ($('.detalle-item').length === 0) {
                $('#sinDetalles').removeClass('d-none');
            } else {
                $('#sinDetalles').addClass('d-none');
            }
        }

        // Validar antes de enviar
        $('#formMovimiento').submit(function(e) {
            if ($('.detalle-item').length === 0) {
                e.preventDefault();
                Swal.fire('Aviso', 'Debe agregar al menos un producto', 'warning');
                return false;
            }
        });
    </script>
}
@model IEnumerable<InventarioWeb.Core.Entities.ConversionUnidad>
@{
    ViewData["Title"] = "Conversiones de Unidades";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right"></i> Conversiones de Unidades</h2>
    <div>
        <form asp-action="CargarDesdeJson" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info me-2"
                    onclick="return confirm('¿Cargar conversiones desde el archivo JSON? Las existentes no se duplicarán.')">
                <i class="bi bi-cloud-download"></i> Cargar desde JSON
            </button>
        </form>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Conversión
        </a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card animate-in">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="text-muted">Sin conversiones definidas</h4>
                <p>Haga clic en "Cargar desde JSON" para importar las conversiones predefinidas.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Unidad Origen</th>
                            <th>Unidad Destino</th>
                            <th>Factor</th>
                            <th>Ejemplo</th>
                            <th>Descripción</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary fs-6">@item.UnidadOrigen?.Abreviatura</span>
                                    <small class="text-muted">@item.UnidadOrigen?.Nombre</small>
                                </td>
                                <td>
                                    <span class="badge bg-success fs-6">@item.UnidadDestino?.Abreviatura</span>
                                    <small class="text-muted">@item.UnidadDestino?.Nombre</small>
                                </td>
                                <td><code>@item.Factor.ToString("0.######")</code></td>
                                <td>
                                    <small>
                                        1 @item.UnidadOrigen?.Abreviatura =
                                        <strong>@item.Factor.ToString("0.######")</strong>
                                        @item.UnidadDestino?.Abreviatura
                                    </small>
                                </td>
                                <td><small>@item.Descripcion</small></td>
                                <td class="text-center">
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar esta conversión?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <small class="text-muted">Total: @Model.Count() conversiones</small>
            </div>
        }
    </div>
</div>
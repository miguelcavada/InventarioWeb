@model IEnumerable<InventarioWeb.Core.DTOs.InventarioDiarioResumenDto>
@{
    ViewData["Title"] = "Inventario Diario";
    var totalVentas = Model.Sum(m => m.Ventas);
    var totalMermas = Model.Sum(m => m.Mermas);
    var totalDevoluciones = Model.Sum(m => m.Devoluciones);
    var valorVendido = Model.Sum(m => m.ValorVentas);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-calendar-check"></i> Inventario Diario</h2>
        <h5 class="text-muted">
            @ViewBag.AlmacenNombre - @ViewBag.Fecha.ToString("dd/MM/yyyy")
        </h5>
    </div>
    <div>
        <a asp-action="InventarioDiarioExcel" asp-route-almacenId="@ViewBag.AlmacenId"
           asp-route-fecha="@ViewBag.Fecha.ToString("yyyy-MM-dd")" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
        <a asp-action="InventarioDiarioPdf" asp-route-almacenId="@ViewBag.AlmacenId"
           asp-route-fecha="@ViewBag.Fecha.ToString("yyyy-MM-dd")" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="row mb-4">
    <div class="col-md-2 mb-2">
        <div class="card bg-primary text-white">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Productos</h6>
                <h3 class="mb-0">@Model.Count()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-2">
        <div class="card bg-info text-white">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Entradas</h6>
                <h3 class="mb-0">@Model.Sum(m => m.Entradas)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-2">
        <div class="card bg-success text-white">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Ventas</h6>
                <h3 class="mb-0">@totalVentas</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-2">
        <div class="card bg-danger text-white">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Mermas</h6>
                <h3 class="mb-0">@totalMermas</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-2">
        <div class="card bg-warning">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Devoluciones</h6>
                <h3 class="mb-0">@totalDevoluciones</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-2">
        <div class="card bg-success text-white">
            <div class="card-body text-center py-3">
                <h6 class="mb-1">Valor Vendido</h6>
                <h4 class="mb-0">@valorVendido.ToString("C2")</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Uni</th>
                        <th class="text-center">Inicial</th>
                        <th class="text-center">Entradas</th>
                        <th class="text-center">Ventas</th>
                        <th class="text-center">Mermas</th>
                        <th class="text-center">Devol.</th>
                        <th class="text-center">Otras</th>
                        <th class="text-center">Final</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.Codigo</code></td>
                            <td>@item.Producto</td>
                            <td>@item.Unidad</td>
                            <td class="text-center">@item.ExistenciaInicial</td>
                            <td class="text-center">
                                @if (item.Entradas > 0)
                                {
                                    <span class="badge bg-info">@item.Entradas</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Ventas > 0)
                                {
                                    <span class="badge bg-success">@item.Ventas</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Mermas > 0)
                                {
                                    <span class="badge bg-danger">@item.Mermas</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Devoluciones > 0)
                                {
                                    <span class="badge bg-warning">@item.Devoluciones</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.OtrasSalidas > 0)
                                {
                                    <span class="badge bg-info">@item.OtrasSalidas</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.ExistenciaFinal <= 0)
                                {
                                    <span class="badge bg-danger">@item.ExistenciaFinal</span>
                                }
                                else
                                {
                                    <span>@item.ExistenciaFinal</span>
                                }
                            </td>
                            <td class="text-end">@item.PrecioMinorista.ToString("C2")</td>
                            <td class="text-end"><strong>@item.ValorVentas.ToString("C2")</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-dark">
                    <tr>
                        <th colspan="5" class="text-end">Totales:</th>
                        <th class="text-center">@totalVentas</th>
                        <th class="text-center">@totalMermas</th>
                        <th class="text-center">@totalDevoluciones</th>
                        <th colspan="3" class="text-end">@valorVendido.ToString("C2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@page "/"
@using InventarioWeb.BlazorApp.Models
@using InventarioWeb.BlazorApp.Services
@inject IDashboardApiService DashboardService

<PageTitle>Dashboard - Inventario</PageTitle>

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h2>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Cargando datos...</p>
    </div>
}
else if (dashboard != null)
{
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam display-4"></i>
                    <h5 class="mt-2">Productos</h5>
                    <h2>@dashboard.TotalProductos</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <i class="bi bi-box-arrow-in-down display-4"></i>
                    <h5 class="mt-2">Entradas</h5>
                    <h2>@dashboard.TotalEntradas</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <i class="bi bi-box-arrow-up display-4"></i>
                    <h5 class="mt-2">Salidas</h5>
                    <h2>@dashboard.TotalSalidas</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle display-4"></i>
                    <h5 class="mt-2">Stock Bajo</h5>
                    <h2>@dashboard.StockBajo</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5><i class="bi bi-cash-stack"></i> Valor del Inventario</h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="text-success">@dashboard.ValorInventario.ToString("C2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5><i class="bi bi-shop"></i> Almacenes</h5>
                </div>
                <div class="card-body text-center">
                    <h2>@dashboard.TotalAlmacenes</h2>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardData? dashboard;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = await DashboardService.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }
}

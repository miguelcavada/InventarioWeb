@page "/productos"
@using InventarioWeb.BlazorApp.Models;
@using InventarioWeb.BlazorApp.Services;
@inject IProductoApiService ProductoService

<PageTitle>Productos - Inventario</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Productos</h2>
    <div class="d-flex gap-2">
        <input type="text" class="form-control" placeholder="Buscar..."
               @bind="buscar" @bind:event="oninput" @onkeyup="Buscar" style="width: 250px;" />
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p>Cargando productos...</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Unidad</th>
                            <th class="text-end">Precio Minorista</th>
                            <th class="text-center">Stock</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!productos.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No hay productos
                                </td>
                            </tr>
                        }
                        @foreach (var p in productos)
                        {
                            <tr>
                                <td><code>@p.Codigo</code></td>
                                <td>@p.Nombre</td>
                                <td><span class="badge bg-info">@p.CategoriaNombre</span></td>
                                <td><span class="badge bg-secondary">@p.UnidadMedidaAbreviatura</span></td>
                                <td class="text-end">@p.PrecioVentaMinorista.ToString("C2")</td>
                                <td class="text-center">
                                    <span class="badge @(p.StockTotal <= p.StockMinimoTotal ? "bg-danger" : "bg-success")">
                                        @p.StockTotal
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<Producto> productos = new();
    private bool loading = true;
    private string buscar = string.Empty;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        loading = true;
        try
        {
            productos = await ProductoService.GetProductosAsync(buscar);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void Buscar()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CargarProductos();
                StateHasChanged();
            });
        }, null, 500, Timeout.Infinite);
    }
}